<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 compile check: proves these sources need no UnityEngine and no API beyond Unity's profile. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Basis.ModelPickup</AssemblyName>
    <RootNamespace>Basis.ModelPickup</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core/** includes the engine-free transport under Core/Transport. -->
    <Compile Include="../../../Core/**/*.cs" />
    <Compile Include="../../../Validation/**/*.cs" />
  </ItemGroup>
</Project>

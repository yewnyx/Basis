<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(ProjectDir)..\..\.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Configurations>Debug;Release</Configurations>
		<BaseOutputPath>$(ProjectDir)..\..\..\Basis Server Export\$(MSBuildProjectName)\bin\</BaseOutputPath>
		<LangVersion>13</LangVersion>
		<!-- Plugin: publish emits the deps.json the loader keys on; the server
		     assemblies resolve to the host's copies instead of shipping in the
		     plugin folder. -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>TRACE;DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BasisNetworkCore\BasisNetworkCore.csproj" Private="false" ExcludeAssets="runtime" />
		<ProjectReference Include="..\..\BasisNetworkServer\BasisNetworkServer.csproj" Private="false" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
	</ItemGroup>
</Project>
